    "Only %@ free where the projects go; the batch may write about %@.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Only %@ free where the projects go; the batch may write about %@." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chỉ còn trống %1$@ ở nơi lưu dự án; lượt chạy có thể ghi khoảng %2$@." } } } },
    "Open Plugin Settings": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Open Plugin Settings" } }, "vi": { "stringUnit": { "state": "translated", "value": "Mở cài đặt plugin" } } } },
