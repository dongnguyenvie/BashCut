    "%@: %d of %d": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@: %d of %d" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@: %d / %d" } } } },
    "Installing %@…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Installing %@…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đang cài %@…" } } } },
