    "Runs these items again from the step that did not complete, in the projects they made": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Runs these items again from the step that did not complete, in the projects they made" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy lại các mục này từ bước chưa xong, trong dự án đã tạo" } } } },
