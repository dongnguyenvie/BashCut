    "Restart %@ tab": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Restart %@ tab" } }, "vi": { "stringUnit": { "state": "translated", "value": "Khởi động lại tab %@" } } } },
    "The running agent loads the new skills only when it restarts; it continues the same conversation.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The running agent loads the new skills only when it restarts; it continues the same conversation." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent đang chạy chỉ nạp kỹ năng mới khi khởi động lại; cuộc trò chuyện vẫn được tiếp tục." } } } },
    "Editing tools": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Editing tools" } }, "vi": { "stringUnit": { "state": "translated", "value": "Công cụ dựng" } } } },
    "Finish setup…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Finish setup…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hoàn tất cài đặt…" } } } },
    "Captions, Vietnamese voice, motion graphics, stock search": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Captions, Vietnamese voice, motion graphics, stock search" } }, "vi": { "stringUnit": { "state": "translated", "value": "Phụ đề, giọng đọc tiếng Việt, đồ hoạ chuyển động, tìm stock" } } } },
    "%@ · about %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ · about %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@ · khoảng %2$@" } } } },
    "%d of %d plugins installed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%d of %d plugins installed" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã cài %1$d/%2$d plugin" } } } },
    "A plugin still needs its setup (Plugins › Installed)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A plugin still needs its setup (Plugins › Installed)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Một plugin vẫn cần cài thêm (Plugin › Đã cài)" } } } },
    "What's this?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "What's this?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đây là gì?" } } } },
    "Setup %d/%d": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Setup %d/%d" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thiết lập %1$d/%2$d" } } } },
    "Set up BashCut for the agent: skills and editing tools": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Set up BashCut for the agent: skills and editing tools" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thiết lập BashCut cho agent: kỹ năng và công cụ dựng" } } } },
    "Tell %@ what to make…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Tell %@ what to make…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Giao việc cho %@…" } } } },
    "the agent": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "the agent" } }, "vi": { "stringUnit": { "state": "translated", "value": "agent" } } } },
    "Opens New brief": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Opens New brief" } }, "vi": { "stringUnit": { "state": "translated", "value": "Mở Giao việc" } } } },
    "Let %@ run commands without asking?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Let %@ run commands without asking?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép %@ chạy lệnh mà không hỏi?" } } } },
    "BashCut runs %@ in Bypass Permissions mode: it does not ask before each command, so you accept responsibility for what it runs. Allow accepts this once, for every project.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "BashCut runs %@ in Bypass Permissions mode: it does not ask before each command, so you accept responsibility for what it runs. Allow accepts this once, for every project." } }, "vi": { "stringUnit": { "state": "translated", "value": "BashCut chạy %@ ở chế độ Bypass Permissions: agent không hỏi trước mỗi lệnh, nên bạn chịu trách nhiệm về những gì nó chạy. Cho phép sẽ chấp nhận một lần cho mọi dự án." } } } },
    "%@ was not started: Bypass Permissions mode was not accepted.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ was not started: Bypass Permissions mode was not accepted." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chưa mở %@: chế độ Bypass Permissions chưa được chấp nhận." } } } },
    "Always for every project in “%@”": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Always for every project in “%@”" } }, "vi": { "stringUnit": { "state": "translated", "value": "Luôn cho phép với mọi dự án trong “%@”" } } } },
    "Let %@ work in “%@”?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Let %@ work in “%@”?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép %@ làm việc trong “%@”?" } } } },
    "It can read, edit and run files there.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "It can read, edit and run files there." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent có thể đọc, sửa và chạy tệp trong thư mục này." } } } },
    "BashCut saves your answer where %@ keeps it, so it does not ask again.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "BashCut saves your answer where %@ keeps it, so it does not ask again." } }, "vi": { "stringUnit": { "state": "translated", "value": "BashCut lưu câu trả lời vào cấu hình của %@ để không phải hỏi lại." } } } },
    "Not now": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Not now" } }, "vi": { "stringUnit": { "state": "translated", "value": "Để sau" } } } },
    "%@ was not started: the folder was not allowed.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ was not started: the folder was not allowed." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chưa mở %@: thư mục chưa được cho phép." } } } },
    "Answer the folder question in BashCut first.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Answer the folder question in BashCut first." } }, "vi": { "stringUnit": { "state": "translated", "value": "Hãy trả lời câu hỏi về thư mục trong BashCut trước." } } } },
