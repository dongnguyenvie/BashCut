    "What should the agent do? Pick a template or write your own.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "What should the agent do? Pick a template or write your own." } }, "vi": { "stringUnit": { "state": "translated", "value": "Bạn muốn agent làm gì? Chọn một mẫu hoặc tự viết." } } } },
