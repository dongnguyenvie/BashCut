    "Install (%d)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Install (%d)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cài đặt (%d)" } } } },
    "Sets up: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sets up: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cài thêm: %@" } } } },
    "Installing trusts the checked plugins' exact files and runs their setup one after another. The plugins and their setup commands run with your user permissions; plugin edits are validated and undoable.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Installing trusts the checked plugins' exact files and runs their setup one after another. The plugins and their setup commands run with your user permissions; plugin edits are validated and undoable." } }, "vi": { "stringUnit": { "state": "translated", "value": "Cài đặt nghĩa là tin cậy đúng các file của những plugin được chọn và chạy phần cài thêm của từng plugin lần lượt. Plugin và các lệnh cài thêm chạy với quyền người dùng của bạn; chỉnh sửa của plugin được kiểm tra và có thể hoàn tác." } } } },
    "Not in the plugin registry": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Not in the plugin registry" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không có trong kho plugin" } } } },
    "Everything in %@ is installed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Everything in %@ is installed" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã cài đủ mọi plugin trong %@" } } } },
