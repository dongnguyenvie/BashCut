    "Product review": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Product review" } }, "vi": { "stringUnit": { "state": "translated", "value": "Review sản phẩm" } } } },
    "Music montage": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Music montage" } }, "vi": { "stringUnit": { "state": "translated", "value": "Montage theo nhạc" } } } },
    "Tutorial": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Tutorial" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hướng dẫn" } } } },
    "Fix a part": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Fix a part" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sửa một đoạn" } } } },
    "I want a vlog about [topic], about [length] long, with a [fun / chill / cinematic] feel.\nThe footage shows [what was filmed]. Music: [style, or none].": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "I want a vlog about [topic], about [length] long, with a [fun / chill / cinematic] feel.\nThe footage shows [what was filmed]. Music: [style, or none]." } }, "vi": { "stringUnit": { "state": "translated", "value": "Tôi muốn dựng một vlog về [chủ đề], dài khoảng [thời lượng], cảm giác [vui / chill / cinematic].\nFootage có [những gì đã quay]. Nhạc: [thể loại, hoặc không cần]." } } } },
    "Make a [15–60] second vertical video about [topic] for [TikTok / Reels / Shorts], with a strong hook in the first 2 seconds and large captions.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Make a [15–60] second vertical video about [topic] for [TikTok / Reels / Shorts], with a strong hook in the first 2 seconds and large captions." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dựng một video dọc [15–60] giây về [chủ đề] cho [TikTok / Reels / Shorts], có hook mạnh trong 2 giây đầu và phụ đề chữ to." } } } },
    "Edit a review of [product]: an intro, [3] main points and a verdict, under [length]. Put a short title on screen for each point.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit a review of [product]: an intro, [3] main points and a verdict, under [length]. Put a short title on screen for each point." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dựng video review [sản phẩm]: mở đầu, [3] ý chính và kết luận, dưới [thời lượng]. Mỗi ý có một tiêu đề ngắn trên màn hình." } } } },
    "Make a montage cut to the beat of [song or music style] from the best shots of [subject], about [length] long.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Make a montage cut to the beat of [song or music style] from the best shots of [subject], about [length] long." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dựng montage cắt theo nhịp [bài hát hoặc thể loại nhạc] từ những cảnh đẹp nhất về [chủ thể], dài khoảng [thời lượng]." } } } },
    "Make a tutorial from the screen recording of [tool], with me in a corner, about [length] long. Zoom in on [the important steps].": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Make a tutorial from the screen recording of [tool], with me in a corner, about [length] long. Zoom in on [the important steps]." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dựng video hướng dẫn từ bản quay màn hình [công cụ], có hình tôi ở góc, dài khoảng [thời lượng]. Zoom vào [các bước quan trọng]." } } } },
    "Explainer": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Explainer" } }, "vi": { "stringUnit": { "state": "translated", "value": "Video giải thích" } } } },
    "Make an explainer video about [topic] for [TikTok / YouTube], about [length] long, with [voiceover / music only]. Explain it in [4–6] parts with cards, numbers and [a map / a chart / a checklist]. Facts from [source].": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Make an explainer video about [topic] for [TikTok / YouTube], about [length] long, with [voiceover / music only]. Explain it in [4–6] parts with cards, numbers and [a map / a chart / a checklist]. Facts from [source]." } }, "vi": { "stringUnit": { "state": "translated", "value": "Làm video giải thích về [chủ đề] cho [TikTok / YouTube], dài khoảng [thời lượng], [có lồng tiếng / chỉ có nhạc]. Giải thích trong [4–6] phần bằng thẻ, con số và [bản đồ / biểu đồ / checklist]. Số liệu lấy từ [nguồn]." } } } },
    "Add [Vietnamese / English] captions for the speech, [white with a shadow / bold yellow], at the [bottom / middle] of the frame.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add [Vietnamese / English] captions for the speech, [white with a shadow / bold yellow], at the [bottom / middle] of the frame." } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm phụ đề [tiếng Việt / tiếng Anh] cho lời nói, kiểu [trắng có bóng / vàng đậm], đặt ở [dưới / giữa] khung hình." } } } },
    "Fix [the selected clip / the part at mm:ss]: [what is wrong]. I want it to [how it should be].": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Fix [the selected clip / the part at mm:ss]: [what is wrong]. I want it to [how it should be]." } }, "vi": { "stringUnit": { "state": "translated", "value": "Sửa [clip đang chọn / đoạn ở phút mm:ss]: [đang bị gì]. Tôi muốn [nó sẽ như thế nào]." } } } },
    "%@ split the memo: %d entries wait for review": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ split the memo: %d entries wait for review" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ đã tách memo: %d mục chờ duyệt" } } } },
    "The request is in the agent's input: send it there": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The request is in the agent's input: send it there" } }, "vi": { "stringUnit": { "state": "translated", "value": "Yêu cầu đã nằm trong ô nhập của agent: gửi nó ở đó" } } } },
    "Open an agent in the dock first, then ask again": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Open an agent in the dock first, then ask again" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hãy mở một agent trong dock trước rồi thử lại" } } } },
    "Kept as notes": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Kept as notes" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã giữ làm ghi chú" } } } },
    "Split this memo into lessons, preferences and facts? The memo stays; what the agent finds waits in the inbox for your review.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Split this memo into lessons, preferences and facts? The memo stays; what the agent finds waits in the inbox for your review." } }, "vi": { "stringUnit": { "state": "translated", "value": "Tách memo này thành bài học, sở thích và dữ kiện? Memo vẫn giữ nguyên; những gì agent tìm được sẽ chờ bạn duyệt trong Hộp duyệt." } } } },
    "Ask the agent to split it": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Ask the agent to split it" } }, "vi": { "stringUnit": { "state": "translated", "value": "Nhờ agent tách" } } } },
    "Keep as notes": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Keep as notes" } }, "vi": { "stringUnit": { "state": "translated", "value": "Giữ làm ghi chú" } } } },
