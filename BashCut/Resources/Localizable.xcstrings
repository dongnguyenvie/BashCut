    "This Mac": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This Mac" } }, "vi": { "stringUnit": { "state": "translated", "value": "Máy Mac này" } } } },
    "This project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dự án này" } } } },
    "BashCut comes with a newer copy (%@), which is used instead": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "BashCut comes with a newer copy (%@), which is used instead" } }, "vi": { "stringUnit": { "state": "translated", "value": "BashCut có sẵn bản mới hơn (%@), bản đó sẽ được dùng" } } } },
    "Used instead of the copy that comes with BashCut (%@)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used instead of the copy that comes with BashCut (%@)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dùng thay cho bản có sẵn trong BashCut (%@)" } } } },
    "Used in this project instead of the copy on this Mac (%@)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used in this project instead of the copy on this Mac (%@)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dùng trong dự án này thay cho bản trên máy Mac (%@)" } } } },
    "This project has its own copy (%@), which is used while it is open": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This project has its own copy (%@), which is used while it is open" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dự án này có bản riêng (%@), bản đó được dùng khi dự án đang mở" } } } },
