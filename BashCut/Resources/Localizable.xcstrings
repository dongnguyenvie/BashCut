    "Add a skill for this project or every project, or read the agent kit's.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a skill for this project or every project, or read the agent kit's." } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm skill cho project này hoặc mọi project, hoặc đọc skill của bộ kỹ năng agent." } } } },
    "Preview": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Preview" } }, "vi": { "stringUnit": { "state": "translated", "value": "Xem trước" } } } },
