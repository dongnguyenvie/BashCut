    "%@ changed: review it and choose Trust to run the new files": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ changed: review it and choose Trust to run the new files" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ đã thay đổi: xem lại và chọn Tin cậy để chạy các file mới" } } } },
    "Reloaded %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Reloaded %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã tải lại %@" } } } },
    "Linked to %@ (developer mode)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Linked to %@ (developer mode)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Liên kết tới %@ (chế độ nhà phát triển)" } } } },
    "Runs from your own folder. After you edit it, choose Reload; changed files need Trust again.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Runs from your own folder. After you edit it, choose Reload; changed files need Trust again." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy từ thư mục của bạn. Sau khi sửa, chọn Tải lại; file đã đổi cần Tin cậy lại." } } } },
    "Pick up your edits: restart the plugin and check its files again": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Pick up your edits: restart the plugin and check its files again" } }, "vi": { "stringUnit": { "state": "translated", "value": "Nhận các thay đổi của bạn: khởi động lại plugin và kiểm tra lại các file" } } } },
    "Update this plugin from a new folder, plugin.json or .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Update this plugin from a new folder, plugin.json or .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cập nhật plugin này từ một thư mục, plugin.json hoặc file .zip mới" } } } },
    "The link, trust and settings on this Mac are removed. Your plugin folder is kept.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The link, trust and settings on this Mac are removed. Your plugin folder is kept." } }, "vi": { "stringUnit": { "state": "translated", "value": "Liên kết, quyền tin cậy và cài đặt trên máy Mac này sẽ bị xoá. Thư mục plugin của bạn được giữ lại." } } } },
    "Runs from your folder instead of a copy. After an edit, choose Reload in Plugins; changed files need Trust again.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Runs from your folder instead of a copy. After an edit, choose Reload in Plugins; changed files need Trust again." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy từ thư mục của bạn thay vì bản sao. Sau khi sửa, chọn Tải lại trong Plugins; file đã đổi cần Tin cậy lại." } } } },
    "Add Plugin": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add Plugin" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin" } } } },
    "Add a plugin that is not in the registry: a link, a folder, its plugin.json, or a .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a plugin that is not in the registry: a link, a folder, its plugin.json, or a .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin không có trong kho: một link, một thư mục, file plugin.json của nó, hoặc file .zip" } } } },
    "Paste a link from the plugin's author, or choose a plugin on this Mac. These plugins are not from the BashCut registry: you see what they do and approve them before they run.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Paste a link from the plugin's author, or choose a plugin on this Mac. These plugins are not from the BashCut registry: you see what they do and approve them before they run." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dán link tác giả plugin gửi, hoặc chọn một plugin trên máy Mac này. Các plugin này không thuộc kho BashCut: bạn xem chúng làm gì và duyệt trước khi chúng chạy." } } } },
    "Link": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Link" } }, "vi": { "stringUnit": { "state": "translated", "value": "Link" } } } },
