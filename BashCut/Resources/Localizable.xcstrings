    "Give at least one input": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Give at least one input" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hãy thêm ít nhất một đầu vào" } } } },
    "Give at least one step": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Give at least one step" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hãy thêm ít nhất một bước" } } } },
    "A preset needs a name with letters or digits": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A preset needs a name with letters or digits" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tên preset cần có chữ cái hoặc chữ số" } } } },
    "A preset needs a name": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A preset needs a name" } }, "vi": { "stringUnit": { "state": "translated", "value": "Preset cần có tên" } } } },
    "A preset needs at least one step": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A preset needs at least one step" } }, "vi": { "stringUnit": { "state": "translated", "value": "Preset cần ít nhất một bước" } } } },
    "outputName needs {name} or {index} so each item's files stay apart": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "outputName needs {name} or {index} so each item's files stay apart" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tên file xuất cần có {name} hoặc {index} để file của từng mục không trùng nhau" } } } },
    "outputName has an unknown {%@}; use %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "outputName has an unknown {%@}; use %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tên file xuất có {%1$@} không hợp lệ; hãy dùng %2$@" } } } },
    "concurrency must be 1…%@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "concurrency must be 1…%@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Số mục chạy cùng lúc phải từ 1 đến %@" } } } },
    "template outputs has an empty preset \"%@\"": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "template outputs has an empty preset \"%@\"" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu ra của mẫu có preset trống \"%@\"" } } } },
    "template outputs: unknown export preset %@; use %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "template outputs: unknown export preset %@; use %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu ra của mẫu: không có preset xuất %1$@; hãy dùng %2$@" } } } },
    "Input %@ does not exist": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input %@ does not exist" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu vào %@ không tồn tại" } } } },
    "Input %@ is relative: give absolute paths or base": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input %@ is relative: give absolute paths or base" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu vào %@ là đường dẫn tương đối: hãy dùng đường dẫn tuyệt đối hoặc base" } } } },
    "projectsFolder %@ is relative: give an absolute path or base": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "projectsFolder %@ is relative: give an absolute path or base" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thư mục project %@ là đường dẫn tương đối: hãy dùng đường dẫn tuyệt đối hoặc base" } } } },
    "%@ is a relative path with no folder to resolve it against: choose it again, or save the preset again from its pipeline file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ is a relative path with no folder to resolve it against: choose it again, or save the preset again from its pipeline file" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ là đường dẫn tương đối, không biết tính từ thư mục nào: hãy chọn lại, hoặc lưu lại preset từ file pipeline của nó" } } } },
    "Input %@ is not a folder": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input %@ is not a folder" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu vào %@ không phải thư mục" } } } },
    "Input %@ is a folder": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input %@ is a folder" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đầu vào %@ là một thư mục" } } } },
    "No project at %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No project at %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không có project ở %@" } } } },
    "No video, audio, image or project in %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No video, audio, image or project in %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không có video, âm thanh, ảnh hay project nào trong %@" } } } },
    "No batch preset \"%@\"; saved: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No batch preset \"%@\"; saved: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không có preset \"%1$@\"; đã lưu: %2$@" } } } },
    "No batch preset \"%@\"": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No batch preset \"%@\"" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không có preset \"%@\"" } } } },
    "Step %@ (%@) needs params.presets or template outputs": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@) needs params.presets or template outputs" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@) cần preset xuất hoặc đầu ra của mẫu" } } } },
    "Step %@ (%@): unknown export preset %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@): unknown export preset %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@): không có preset xuất %3$@" } } } },
    "Step %@ (%@): no command or installed plugin action has this ID (plugins actions lists plugin actions)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@): no command or installed plugin action has this ID (plugins actions lists plugin actions)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@): không có lệnh hay hành động plugin đã cài nào mang ID này" } } } },
    "Step %@ (%@) needs the user's approval each time, so it cannot run in a batch; use the export step instead": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@) needs the user's approval each time, so it cannot run in a batch; use the export step instead" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@) cần bạn duyệt mỗi lần nên không chạy hàng loạt được; hãy dùng bước Xuất video" } } } },
    "Step %@ (%@) needs the user's approval each time, so it cannot run in a batch": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@) needs the user's approval each time, so it cannot run in a batch" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@) cần bạn duyệt mỗi lần nên không chạy hàng loạt được" } } } },
    "Step %@ (%@) cannot run in a batch: the runner opens each item's project itself": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@) cannot run in a batch: the runner opens each item's project itself" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@) không chạy hàng loạt được: lượt chạy tự mở project của từng mục" } } } },
    "Step %@ (%@): %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Step %@ (%@): %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bước %1$@ (%2$@): %3$@" } } } },
    "Stopped after a failed item (onFailure stop)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Stopped after a failed item (onFailure stop)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã dừng sau một mục bị lỗi" } } } },
    "Could not open its project: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Could not open its project: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Không mở được project của mục: %@" } } } },
