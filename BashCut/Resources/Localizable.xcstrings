    "Needs a newer BashCut: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Needs a newer BashCut: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cần BashCut mới hơn: %@" } } } },
    "Continue": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Continue" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tiếp tục" } } } },
    "%@ also needs %@, which is not in the registry": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ also needs %@, which is not in the registry" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@ còn cần %2$@, plugin này không có trong registry" } } } },
    "%@ needs %@: review its installation": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ needs %@: review its installation" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@ cần %2$@: hãy xem lại bản cài đặt" } } } },
    "%@ needs %@: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ needs %@: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@ cần %2$@: %3$@" } } } },
    "Requested by %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Requested by %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Yêu cầu bởi %@" } } } },
    "Copy…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Copy…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sao chép…" } } } },
    "Copy to This Project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Copy to This Project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sao chép vào project này" } } } },
    "Copy for Every Project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Copy for Every Project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sao chép cho mọi project" } } } },
    "Plugin skills are read-only and go away with the plugin. Copy one to change it.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Plugin skills are read-only and go away with the plugin. Copy one to change it." } }, "vi": { "stringUnit": { "state": "translated", "value": "Skill của plugin chỉ đọc và mất đi cùng plugin. Hãy sao chép nếu muốn sửa." } } } },
    "Skill copied to this project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill copied to this project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã sao chép skill vào project này" } } } },
    "Skill copied for every project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill copied for every project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã sao chép skill cho mọi project" } } } },
    "A skill named %@ already exists there": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A skill named %@ already exists there" } }, "vi": { "stringUnit": { "state": "translated", "value": "Ở đó đã có skill tên %@" } } } },
    "Agent skills: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agent skills: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Skill cho agent: %@" } } } },
    "Agents get these skills while the plugin is trusted and on (Knowledge › Skills).": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agents get these skills while the plugin is trusted and on (Knowledge › Skills)." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent nhận các skill này khi plugin được tin cậy và đang bật (Kiến thức › Skill)." } } } },
    "Teaches agents: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Teaches agents: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dạy agent: %@" } } } },
    "Agent permissions": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agent permissions" } }, "vi": { "stringUnit": { "state": "translated", "value": "Quyền của agent" } } } },
    "Approve agent actions without asking": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Approve agent actions without asking" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tự duyệt hành động của agent" } } } },
    "Dangerously allow all agent actions": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Dangerously allow all agent actions" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho agent toàn quyền (nguy hiểm)" } } } },
    "Agent actions that ask first: exports, agent kit setup and updates, library items and preferences for every project. Every request is still logged.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agent actions that ask first: exports, agent kit setup and updates, library items and preferences for every project. Every request is still logged." } }, "vi": { "stringUnit": { "state": "translated", "value": "Các hành động của agent cần hỏi trước: xuất video, cài đặt và cập nhật agent kit, mục thư viện và tuỳ chọn dùng cho mọi dự án. Mọi yêu cầu vẫn được ghi log." } } } },
    "All agent actions run without asking, including plugin actions that normally ask first. Installing and trusting plugins follows Settings › Plugins.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "All agent actions run without asking, including plugin actions that normally ask first. Installing and trusting plugins follows Settings › Plugins." } }, "vi": { "stringUnit": { "state": "translated", "value": "Mọi hành động của agent chạy mà không hỏi, kể cả hành động plugin thường cần xác nhận. Việc cài và tin cậy plugin theo Cài đặt › Plugin." } } } },
    "Let agents do everything without asking?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Let agents do everything without asking?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho agent làm mọi thứ mà không hỏi?" } } } },
    "Agents can edit any clip, export, change the agent kit, save library items and preferences for every project, and run plugin actions without asking you. Every request is still logged.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agents can edit any clip, export, change the agent kit, save library items and preferences for every project, and run plugin actions without asking you. Every request is still logged." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent có thể sửa mọi clip, xuất video, thay đổi agent kit, lưu mục thư viện và tuỳ chọn cho mọi dự án, và chạy hành động plugin mà không hỏi bạn. Mọi yêu cầu vẫn được ghi log." } } } },
    "Allow Everything": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow Everything" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép tất cả" } } } },
    "Allow for This Request lets the agent change anything else until your next message, or until the clips sent to a terminal change.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow for This Request lets the agent change anything else until your next message, or until the clips sent to a terminal change." } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép cho yêu cầu này: agent được sửa chỗ khác cho đến tin nhắn tiếp theo của bạn, hoặc đến khi các clip đã gửi cho terminal thay đổi." } } } },
    "Rejected an edit by %@ outside the attached clips": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Rejected an edit by %@ outside the attached clips" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã từ chối một thay đổi của %@ ngoài các clip đã gửi" } } } },
    "Edits outside the attached clips": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edits outside the attached clips" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sửa ngoài các clip đã gửi" } } } },
    "Ask first": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Ask first" } }, "vi": { "stringUnit": { "state": "translated", "value": "Hỏi trước" } } } },
    "Block": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Block" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chặn" } } } },
    "When you send clips to an agent, its edits to other clips or to the whole project ask you first, are blocked, or are allowed.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "When you send clips to an agent, its edits to other clips or to the whole project ask you first, are blocked, or are allowed." } }, "vi": { "stringUnit": { "state": "translated", "value": "Khi bạn gửi clip cho agent, các thay đổi của agent lên clip khác hoặc toàn dự án sẽ hỏi bạn trước, bị chặn, hoặc được cho phép." } } } },
    "%@ wants to edit outside the attached clips": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ wants to edit outside the attached clips" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ muốn sửa ngoài các clip đã gửi" } } } },
    "This edit also changes: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This edit also changes: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thay đổi này còn sửa: %@" } } } },
    "Allow Once": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow Once" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép lần này" } } } },
    "Allow for This Request": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow for This Request" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cho phép cho yêu cầu này" } } } },
    "Edit text style": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit text style" } }, "vi": { "stringUnit": { "state": "translated", "value": "Sửa kiểu chữ" } } } },
    "Outline": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Outline" } }, "vi": { "stringUnit": { "state": "translated", "value": "Viền chữ" } } } },
    "Use preset style": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Use preset style" } }, "vi": { "stringUnit": { "state": "translated", "value": "Dùng kiểu mặc định" } } } },
    "Font size as a share of the frame's short side": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Font size as a share of the frame's short side" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cỡ chữ theo tỉ lệ cạnh ngắn của khung hình" } } } },
    "Baseline height from the bottom of the frame": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Baseline height from the bottom of the frame" } }, "vi": { "stringUnit": { "state": "translated", "value": "Độ cao dòng chữ tính từ đáy khung hình" } } } },
    "Clears the stored size, position and outline": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Clears the stored size, position and outline" } }, "vi": { "stringUnit": { "state": "translated", "value": "Xoá cỡ chữ, vị trí và viền đã lưu" } } } },
    "Generate library items": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Generate library items" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tạo mục thư viện" } } } },
