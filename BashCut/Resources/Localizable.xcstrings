    "Skill added for every project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill added for every project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã thêm skill cho mọi project" } } } },
    "Skill turned on": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill turned on" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã bật skill" } } } },
    "Skill turned off": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill turned off" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã tắt skill" } } } },
    "Delete the skill “%@”?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Delete the skill “%@”?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Xóa skill “%@”?" } } } },
    "Agents stop using it. History keeps a copy, so you can bring it back.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agents stop using it. History keeps a copy, so you can bring it back." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent sẽ không dùng nữa. Lịch sử vẫn giữ một bản để bạn khôi phục." } } } },
    "Skill deleted": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill deleted" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã xóa skill" } } } },
