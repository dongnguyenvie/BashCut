{
  "sourceLanguage": "en",
  "strings": {
    "Older memo found at %@. BashCut now keeps knowledge in the project.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Older memo found at %@. BashCut now keeps knowledge in the project." } }, "vi": { "stringUnit": { "state": "translated", "value": "Tìm thấy memo cũ ở %@. BashCut giờ lưu knowledge trong project." } } } },
    "Move to notes for every project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Move to notes for every project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chuyển vào ghi chú cho mọi project" } } } },
    "Move to this project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Move to this project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chuyển vào project này" } } } },
    "Save the project to keep a memo and skills in its folder.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Save the project to keep a memo and skills in its folder." } }, "vi": { "stringUnit": { "state": "translated", "value": "Lưu project để giữ memo và skill trong thư mục của nó." } } } },
    "Notes for every project": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Notes for every project" } }, "vi": { "stringUnit": { "state": "translated", "value": "Ghi chú cho mọi project" } } } },
    "Save notes": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Save notes" } }, "vi": { "stringUnit": { "state": "translated", "value": "Lưu ghi chú" } } } },
    "Notes for every project saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Notes for every project saved" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu ghi chú cho mọi project" } } } },
    "Older memo moved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Older memo moved" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã chuyển memo cũ" } } } },
    "Project memo saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Project memo saved" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu memo của project" } } } },
    "Skill shared with Claude and Codex": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill shared with Claude and Codex" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã chia sẻ skill với Claude và Codex" } } } },
    "Skill saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill saved" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu skill" } } } },
    "Skill available to both agents": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skill available to both agents" } }, "vi": { "stringUnit": { "state": "translated", "value": "Skill đã dùng được cho cả hai agent" } } } },
    "Waiting for approval: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Waiting for approval: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đang chờ phê duyệt: %@" } } } },
    "Link (developer mode)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Link (developer mode)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Liên kết (chế độ nhà phát triển)" } } } },
    "Install as": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Install as" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cài dạng" } } } },
    "Reload": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Reload" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tải lại" } } } },
    "Replace…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Replace…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thay thế…" } } } },
    "%@ is linked; use Reload after you edit it": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ is linked; use Reload after you edit it" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã liên kết %@; bấm Tải lại sau khi bạn sửa" } } } },
    "Choose the new version of %@: a folder, its plugin.json, or a .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose the new version of %@: a folder, its plugin.json, or a .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chọn bản mới của %@: một thư mục, file plugin.json của nó, hoặc file .zip" } } } },
    "%@ is no longer installed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ is no longer installed" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ không còn được cài" } } } },
    "%@ changed: review it and choose Trust to run the new files": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ changed: review it and choose Trust to run the new files" } }, "vi": { "stringUnit": { "state": "translated", "value": "%@ đã thay đổi: xem lại và chọn Tin cậy để chạy các file mới" } } } },
    "Reloaded %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Reloaded %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã tải lại %@" } } } },
    "Linked to %@ (developer mode)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Linked to %@ (developer mode)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Liên kết tới %@ (chế độ nhà phát triển)" } } } },
    "Runs from your own folder. After you edit it, choose Reload; changed files need Trust again.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Runs from your own folder. After you edit it, choose Reload; changed files need Trust again." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy từ thư mục của bạn. Sau khi sửa, chọn Tải lại; file đã đổi cần Tin cậy lại." } } } },
    "Pick up your edits: restart the plugin and check its files again": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Pick up your edits: restart the plugin and check its files again" } }, "vi": { "stringUnit": { "state": "translated", "value": "Nhận các thay đổi của bạn: khởi động lại plugin và kiểm tra lại các file" } } } },
    "Update this plugin from a new folder, plugin.json or .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Update this plugin from a new folder, plugin.json or .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cập nhật plugin này từ một thư mục, plugin.json hoặc file .zip mới" } } } },
    "The link, trust and settings on this Mac are removed. Your plugin folder is kept.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The link, trust and settings on this Mac are removed. Your plugin folder is kept." } }, "vi": { "stringUnit": { "state": "translated", "value": "Liên kết, quyền tin cậy và cài đặt trên máy Mac này sẽ bị xoá. Thư mục plugin của bạn được giữ lại." } } } },
    "Runs from your folder instead of a copy. After an edit, choose Reload in Plugins; changed files need Trust again.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Runs from your folder instead of a copy. After an edit, choose Reload in Plugins; changed files need Trust again." } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy từ thư mục của bạn thay vì bản sao. Sau khi sửa, chọn Tải lại trong Plugins; file đã đổi cần Tin cậy lại." } } } },
    "Add Plugin": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add Plugin" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin" } } } },
    "Add a plugin that is not in the registry: a link, a folder, its plugin.json, or a .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a plugin that is not in the registry: a link, a folder, its plugin.json, or a .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin không có trong kho: một link, một thư mục, file plugin.json của nó, hoặc file .zip" } } } },
    "Paste a link from the plugin's author, or choose a plugin on this Mac. These plugins are not from the BashCut registry: you see what they do and approve them before they run.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Paste a link from the plugin's author, or choose a plugin on this Mac. These plugins are not from the BashCut registry: you see what they do and approve them before they run." } }, "vi": { "stringUnit": { "state": "translated", "value": "Dán link tác giả plugin gửi, hoặc chọn một plugin trên máy Mac này. Các plugin này không thuộc kho BashCut: bạn xem chúng làm gì và duyệt trước khi chúng chạy." } } } },
    "Link": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Link" } }, "vi": { "stringUnit": { "state": "translated", "value": "Link" } } } },
    "SHA-256 (optional)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "SHA-256 (optional)" } }, "vi": { "stringUnit": { "state": "translated", "value": "SHA-256 (không bắt buộc)" } } } },
    "Choose File or Folder…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose File or Folder…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chọn file hoặc thư mục…" } } } },
    "Download": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Download" } }, "vi": { "stringUnit": { "state": "translated", "value": "Tải về" } } } },
    "A .zip or .bashcutplugin link, a GitHub repo (or a folder or plugin.json in it), or a GitHub release": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A .zip or .bashcutplugin link, a GitHub repo (or a folder or plugin.json in it), or a GitHub release" } }, "vi": { "stringUnit": { "state": "translated", "value": "Link tới file .zip hoặc .bashcutplugin, một repo GitHub (hoặc thư mục hay plugin.json trong đó), hoặc một bản release GitHub" } } } },
    "Archive %@ from %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Archive %@ from %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "File nén %1$@ từ %2$@" } } } },
    "GitHub repo %@ at %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitHub repo %@ at %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Repo GitHub %1$@ tại %2$@" } } } },
    "the default branch": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "the default branch" } }, "vi": { "stringUnit": { "state": "translated", "value": "nhánh mặc định" } } } },
    "GitHub release %@ of %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitHub release %@ of %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bản release %1$@ của %2$@" } } } },
    "latest": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "latest" } }, "vi": { "stringUnit": { "state": "translated", "value": "mới nhất" } } } },
    "Access token for %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Access token for %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Access token cho %@" } } } },
    "Access token for %@ is saved": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Access token for %@ is saved" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã lưu access token cho %@" } } } },
    "No access token for %@ (only needed for private links)": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No access token for %@ (only needed for private links)" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chưa có access token cho %@ (chỉ cần cho link riêng tư)" } } } },
    "Kept in the Keychain on this Mac and sent only to %@. Needed for private repos and links.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Kept in the Keychain on this Mac and sent only to %@. Needed for private repos and links." } }, "vi": { "stringUnit": { "state": "translated", "value": "Lưu trong Keychain của máy Mac này và chỉ gửi tới %@. Cần cho repo và link riêng tư." } } } },
    "Change…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Change…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đổi…" } } } },
    "Add Token…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add Token…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm token…" } } } },
    "From a link": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "From a link" } }, "vi": { "stringUnit": { "state": "translated", "value": "Từ một link" } } } },
    "Resolved to %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Resolved to %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã xác định: %@" } } } },
    "Installed from this link; it is not in the BashCut registry": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Installed from this link; it is not in the BashCut registry" } }, "vi": { "stringUnit": { "state": "translated", "value": "Cài từ link này; không thuộc kho BashCut" } } } },
    "Add Plugin…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add Plugin…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin…" } } } },
    "Add a plugin that is not in the registry: a folder, its plugin.json, or a .zip file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a plugin that is not in the registry: a folder, its plugin.json, or a .zip file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Thêm plugin không có trong kho: một thư mục, file plugin.json của nó, hoặc file .zip" } } } },
    "Choose a plugin folder, its plugin.json, or a .zip or .bashcutplugin file": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose a plugin folder, its plugin.json, or a .zip or .bashcutplugin file" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chọn thư mục plugin, file plugin.json của nó, hoặc file .zip hay .bashcutplugin" } } } },
    "From this Mac": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "From this Mac" } }, "vi": { "stringUnit": { "state": "translated", "value": "Từ máy Mac này" } } } },
    "Version %@ · %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Version %@ · %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "Phiên bản %1$@ · %2$@" } } } },
    "Not from the BashCut registry · unsigned. Install it only if you trust where it comes from.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Not from the BashCut registry · unsigned. Install it only if you trust where it comes from." } }, "vi": { "stringUnit": { "state": "translated", "value": "Không thuộc kho plugin BashCut · chưa ký. Chỉ cài nếu bạn tin nguồn của nó." } } } },
