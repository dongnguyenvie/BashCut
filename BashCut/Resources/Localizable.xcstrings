    "The agent changes only these clips, then reviews this part.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The agent changes only these clips, then reviews this part." } }, "vi": { "stringUnit": { "state": "translated", "value": "Agent chỉ sửa các clip này, rồi kiểm tra lại đoạn này." } } } },
