    "Kit skills are read-only. Propose a change to send it to the Inbox for review.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Kit skills are read-only. Propose a change to send it to the Inbox for review." } }, "vi": { "stringUnit": { "state": "translated", "value": "Skill của bộ kỹ năng chỉ đọc. Hãy đề xuất thay đổi để gửi vào Hộp duyệt." } } } },
