    "Tell me": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Tell me" } }, "vi": { "stringUnit": { "state": "translated", "value": "Báo tôi" } } } },
    "Skip": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Skip" } }, "vi": { "stringUnit": { "state": "translated", "value": "Bỏ qua" } } } },
