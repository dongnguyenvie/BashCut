{
  "sourceLanguage": "en",
  "strings": {
    "%@ elapsed": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@ elapsed" } }, "vi": { "stringUnit": { "state": "translated", "value": "đã chạy %@" } } } },
    "%@: %@. Its steps that need the key will fail on every item.": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@: %@. Its steps that need the key will fail on every item." } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@: %2$@. Các bước cần khoá sẽ lỗi ở mọi mục." } } } },
    "%@: %lld of %lld items done, %lld left. Resume it now?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@: %lld of %lld items done, %lld left. Resume it now?" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$@: xong %2$lld/%3$lld mục, còn %4$lld. Chạy tiếp ngay?" } } } },
    "%lld files cannot be read or played: %@": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%lld files cannot be read or played: %@" } }, "vi": { "stringUnit": { "state": "translated", "value": "%1$lld tệp không đọc hoặc phát được: %2$@" } } } },
    "%lld of %lld items are done. Quit now and resume the rest the next time BashCut opens?": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%lld of %lld items are done. Quit now and resume the rest the next time BashCut opens?" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đã xong %1$lld/%2$lld mục. Thoát bây giờ và chạy tiếp phần còn lại lần sau mở BashCut?" } } } },
    "%lld of %lld items done": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%lld of %lld items done" } }, "vi": { "stringUnit": { "state": "translated", "value": "Xong %1$lld/%2$lld mục" } } } },
    "A batch is still running": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A batch is still running" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đang chạy hàng loạt" } } } },
    "A batch was interrupted": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A batch was interrupted" } }, "vi": { "stringUnit": { "state": "translated", "value": "Một lượt chạy hàng loạt bị gián đoạn" } } } },
    "Batch finished": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Batch finished" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy hàng loạt xong" } } } },
    "Batch finished with failures": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Batch finished with failures" } }, "vi": { "stringUnit": { "state": "translated", "value": "Chạy hàng loạt xong, có mục lỗi" } } } },
    "Check before the batch runs": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Check before the batch runs" } }, "vi": { "stringUnit": { "state": "translated", "value": "Kiểm tra trước khi chạy hàng loạt" } } } },
    "Checking keys, files and disk space…": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Checking keys, files and disk space…" } }, "vi": { "stringUnit": { "state": "translated", "value": "Đang kiểm tra khoá, tệp và dung lượng đĩa…" } } } },
