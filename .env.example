# Copy to .env (git-ignored) and fill in. Scripts read only BASHCUT_* keys (scripts/lib/common.sh).

# Apple Developer team and account: scripts/build-release.sh, scripts/deploy-testflight.sh
BASHCUT_TEAM_ID=
BASHCUT_APPLE_ID=
# App-specific password from appleid.apple.com, for notarization
BASHCUT_NOTARY_PASSWORD=
# Optional: release identities; default to the team's "Developer ID Application" / "Developer ID Installer"
BASHCUT_RELEASE_IDENTITY=
BASHCUT_INSTALLER_IDENTITY=
# Optional: identity for scripts/run.sh dev builds; defaults to the first Apple Development identity
BASHCUT_SIGN_IDENTITY=
# Optional: scripts/publish-homebrew.sh; default to the origin remote and <owner>/homebrew-tap
BASHCUT_GITHUB_REPO=
BASHCUT_HOMEBREW_TAP=
