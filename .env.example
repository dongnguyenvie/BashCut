# Copy to .env (git-ignored) and fill in. Release scripts read only BASHCUT_* keys.

# Apple Developer team and account (scripts/build-release.sh, TestFlight uploads)
BASHCUT_TEAM_ID=
BASHCUT_APPLE_ID=
# App-specific password from appleid.apple.com, for notarization
BASHCUT_NOTARY_PASSWORD=
# Optional: defaults to the team's "Developer ID Application" / "Developer ID Installer" identity in the keychain
BASHCUT_SIGN_IDENTITY=
BASHCUT_INSTALLER_IDENTITY=
